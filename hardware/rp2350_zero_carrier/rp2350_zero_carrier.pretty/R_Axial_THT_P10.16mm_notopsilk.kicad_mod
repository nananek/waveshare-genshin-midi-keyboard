(footprint "R_Axial_THT_P10.16mm_notopsilk"
  (version 20221018)
  (generator "handwritten")
  (layer "F.Cu")
  (descr "Generic axial THT resistor, DIN0207-ish, pitch 10.16mm (400mil), round PTH pads dia1.6mm/drill0.8mm. R2-only bottom-assembly variant: insert the resistor body on B.Cu and solder from F.Cu. This keeps the body clear of the TPS2553 support components placed between the leads on F.Cu. R2 is excluded from the board-wide silkscreen swap (like U1): its printed reference designator, assembly note, and body outline all stay on B.Silkscreen (mirrored), matching the face the body actually occupies. The outline is the same rectangle as R1's F.Silkscreen/B.Silkscreen body outline, added here as real printed graphics since B.Fab/B.CrtYd are documentation-only layers that never reach the manufactured board. Value stays on the unprinted B.Fab layer.")
  (tags "resistor axial THT")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -3) (layer "B.SilkS")
    (effects (font (size 1 1) (thickness 0.15)) (justify mirror))
  )
  (fp_text user "MOUNT BOTTOM" (at 1.5 2.5) (layer "B.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)) (justify mirror))
  )
  (fp_text value "R_Axial_THT_P10.16mm_notopsilk" (at 0 3) (layer "B.Fab")
    (effects (font (size 1 1) (thickness 0.15)) (justify mirror))
  )
  (fp_line (start -3.15 -1.2) (end 3.15 -1.2) (layer "B.SilkS") (width 0.15))
  (fp_line (start -3.15 1.2) (end -3.15 -1.2) (layer "B.SilkS") (width 0.15))
  (fp_line (start 3.15 -1.2) (end 3.15 1.2) (layer "B.SilkS") (width 0.15))
  (fp_line (start 3.15 1.2) (end -3.15 1.2) (layer "B.SilkS") (width 0.15))
  (fp_rect (start -3.15 -1.2) (end 3.15 1.2) (stroke (width 0.1) (type default)) (fill none) (layer "B.Fab"))
  (fp_rect (start -3.4 -1.45) (end 3.4 1.45) (stroke (width 0.05) (type default)) (fill none) (layer "B.CrtYd"))
  (pad "1" thru_hole circle (at -5.08 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 5.08 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask"))
)
