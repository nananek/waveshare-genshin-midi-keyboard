(footprint "TPS2553DBVR"
  (version 20221018)
  (generator "handwritten")
  (layer "F.Cu")
  (descr "TI TPS2553DBVR, SOT-23 (DBV), 6 pins. Pin function assignment verified against TI datasheet SLVS841F (TPS2552/TPS2553), section 6 'Pin Configuration and Functions', DBV package top view: pin1=IN, pin2=GND, pin3=EN, pin4=FAULT, pin5=ILIM, pin6=OUT (left column top-to-bottom IN/GND/EN, right column top-to-bottom OUT/ILIM/FAULT). Land pattern uses generic JEDEC SOT-23-6 dimensions (body ref 2.9x1.6mm per datasheet Device Information table; pad pitch 0.95mm within each row, row-to-row span 3.0mm). Pad size reduced to 0.8x0.6mm (from a more generous 1.0x0.6mm first draft) specifically to widen the routing channel between this part's own left/right pin columns on the very dense carrier board -- still within normal SOT-23-6 land-pattern practice, but visually confirm against the actual reel/part before reflow, consistent with this project's other self-authored footprints. No silkscreen body outline (omitted to avoid silkscreen-over-copper conflicts with the adjacent R2 footprint on this densely packed board); reference/value text is on F.Fab only.")
  (tags "TPS2553 SOT-23-6 SOT-23 power switch")
  (attr smd)
  (fp_text reference "REF**" (at 0 0) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text value "TPS2553DBVR" (at 0 2.4) (layer "F.Fab")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (pad "1" smd roundrect (at -1.5 0.95) (size 0.7 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
  (pad "2" smd roundrect (at -1.5 0) (size 0.7 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
  (pad "3" smd roundrect (at -1.5 -0.95) (size 0.7 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
  (pad "4" smd roundrect (at 1.5 -0.95) (size 0.7 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
  (pad "5" smd roundrect (at 1.5 0) (size 0.7 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
  (pad "6" smd roundrect (at 1.5 0.95) (size 0.7 0.6) (layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
