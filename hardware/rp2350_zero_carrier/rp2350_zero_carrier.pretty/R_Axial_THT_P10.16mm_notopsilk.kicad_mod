(footprint "R_Axial_THT_P10.16mm_notopsilk"
  (version 20221018)
  (generator "handwritten")
  (layer "F.Cu")
  (descr "Generic axial THT resistor, DIN0207-ish, pitch 10.16mm (400mil), round PTH pads dia1.6mm/drill0.8mm. Variant of R_Axial_THT_P10.16mm with the silkscreen body outline removed entirely. Used only for R2, whose position (12.7,-17.78) sits directly beside the new TPS2553 (U1) pads added for USB-A VBUS protection -- the standard silk outline's top edge (local y=+/-1.2mm) crossed U1's pin1/pin2/pin3/pin5/pin6 pads, causing silk-over-copper DRC violations. R1 (same electrical role, opposite side of the board, far from U1) keeps the original R_Axial_THT_P10.16mm footprint with silk intact; only R2's silk was removed, hence the separate footprint name to avoid a lib_footprint_mismatch DRC warning against the shared library entry.")
  (tags "resistor axial THT")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -3) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "R_Axial_THT_P10.16mm_notopsilk" (at 0 3) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (pad "1" thru_hole circle (at -5.08 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 5.08 0) (size 1.6 1.6) (drill 0.8) (layers "*.Cu" "*.Mask"))
)
