(footprint "RP2350_Zero_Header_23p"
  (version 20221018)
  (generator "handwritten")
  (layer "F.Cu")
  (descr "RP2350-Zero pin-socket footprint (female, board side), 23 physical pins (20 GPIO + 5V/GND/3V3), corrected 2026-08-21 after cross-checking Waveshare wiki dimension drawing + SwitchScience pinout diagram (2 independent public images). Origin = module center. Left column (9 pins, X=-7.62mm, HIGH confidence, read directly off the wiki dimension drawing): 5V,GND,3V3,GP29,GP28,GP27,GP26,GP15,GP14 (top to bottom). Right column (8 pins, X=+7.62mm, MEDIUM confidence, positions estimated from the standard 2.54mm grid, not individually dimensioned in the source drawing): GP0..GP7 (top to bottom). Bottom row (6 pins, Y=-12.70mm, MEDIUM confidence, same grid-estimate caveat): GP13,GP12,GP11,GP10,GP9,GP8 (left to right); GP12/GP13 = USB host D+/D-, adjacent by construction. IMPORTANT: before gerber ordering, visually compare this footprint's pin layout against the Waveshare wiki pinout/dimension images -- the physical module's silkscreen is not readable after header pins were soldered, so this visual comparison is the only remaining verification method for the MEDIUM-confidence pins (right column + bottom row).")
  (tags "RP2350-Zero header socket 23pin")
  (attr through_hole)
  (fp_text reference "REF**" (at 0 -14) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "RP2350_Zero_Header_23p" (at 0 14) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text user "USB-C / BOOT-RUN side" (at 0 10.9) (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text user "right col + bottom row: GRID-ESTIMATED, verify vs wiki image" (at 0 -10.9) (layer "Cmts.User")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
