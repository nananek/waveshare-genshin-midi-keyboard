  (text "U1 TPS2553DBVR: EN(pin3)=USB_PWR_EN/GP9、FAULT(pin4)=USB_PWR_FAULT_N/GP10。\nR_EN=100kΩでboot default off。FAULTはR_FAULT=100kΩで3V3へpull-up。\nOUT(pin6)=VBUS_USB_A、COUT_HF=100nFをOUT-GND直近に配置。"
    (at 205 232 0)
    (effects (font (size 1.27 1.27)) (justify left))
    (uuid "b1c9a1a0-t001-4a00-9000-000000000001")
  )
